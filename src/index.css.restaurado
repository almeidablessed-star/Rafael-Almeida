@import "tailwindcss";

/* ================================================================
   Carula Confeitaria — camada visual do redesign
   Cole ESTE bloco no topo de src/index.css, depois dos imports
   do Tailwind. Não remove nada da lógica; só define tokens,
   fontes, keyframes e as classes usadas pelos componentes de
   carula-ui.tsx.
   ================================================================ */

/* === GOOGLE FONTS === */
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fredoka:wght@500;600;700&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600;1,700&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  /* marca */
  --car-brand-900: #3A2350;
  --car-brand-800: #4A2A5C;
  --car-brand-700: #6E3F72;
  --car-brand-600: #A85E86;

  /* rosé */
  --car-rose-200: #F5B9C6;
  --car-rose-100: #F5CFD4;
  --car-rose-50: #FFF8F6;

  /* neutro */
  --car-sand-200: #E4D9C3;
  --car-sand-100: #EDE7DC;
  --car-sand-50: #F6F2F5;
  --car-text-900: #241B2B;
  --car-text-800: #2B2420;
  --car-text-700: #5A4E46;
  --car-text-600: #7A6E80;

  /* apoio */
  --car-green: #A9D8B8;
  --car-gold: #B08D57;
}

/* === KEYFRAMES === */
@keyframes carFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

@keyframes carShimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes carRing {
  from { stroke-dashoffset: 339; }
  to { stroke-dashoffset: 105; }
}

@keyframes carRingB {
  from { stroke-dashoffset: 301; }
  to { stroke-dashoffset: 66; }
}

@keyframes carGlow {
  0%, 100% { opacity: .45; transform: scale(1); }
  50% { opacity: .8; transform: scale(1.06); }
}

@keyframes carRise {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes carSweep {
  0% { transform: translateX(-120%); }
  60%, 100% { transform: translateX(220%); }
}

/* === GLOBAL STYLES === */
body {
  margin: 0;
  background: var(--car-sand-100);
  font-family: 'Plus Jakarta Sans', 'Manrope', sans-serif;
  font-variant-numeric: lining-nums tabular-nums;
  color: var(--car-text-900);
}

a {
  color: #E82C1B;
  text-decoration: none;
}

a:hover {
  color: var(--car-text-800);
}

/* === UTILITÁRIOS === */
.car-float {
  animation: carFloat 4.5s ease-in-out infinite;
}

.car-sweep {
  animation: carSweep 5s ease-in-out infinite;
}

.car-glow {
  animation: carGlow 3s ease-in-out infinite;
}

.car-rise {
  animation: carRise 0.6s ease-out;
}

.font-serif-display {
  font-family: 'Instrument Serif', serif;
}

.font-serif-elegant {
  font-family: 'Playfair Display', serif;
}
